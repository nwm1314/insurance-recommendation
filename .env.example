# Application settings. Use uppercase names for Docker Compose interpolation.
# LLM_API_KEY is REQUIRED: if empty, AI 专家模式 silently degrades to rule mode
# (docker compose refuses to start without it). All keys MUST be UPPERCASE,
# lowercase names (e.g. llm_api_key) are only read by the app itself, NOT by
# docker compose interpolation — a lowercase-only .env will deploy with no LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=2048
LLM_READ_TIMEOUT=90.0
# CORS 白名单：逗号分隔的显式来源（http/https，可含端口），如
# http://localhost:3000,https://app.example.com。不允许带路径/查询串/片段；
# 生产（APP_ENV=production）禁止使用通配符 *（启动报错 fail-closed）。
# Cookie 认证要求 allow_credentials=True，任何环境都不得配置 * 与凭据并用。
CORS_ALLOW_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=change_me_before_deploy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
# 受控管理员初始化：启动时若 FIRST_ADMIN_PASSWORD 非空且该邮箱用户不存在，
# 则创建管理员并写入审计日志（action=auth.first_admin.bootstrap）。密码不出现在
# 日志或响应中；创建后建议清空该变量。此后新管理员只能由既有管理员通过
# POST /api/admin/users/{user_id}/roles（需 admin:grant 权限）授予。
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=
DISABLE_SCHEDULER_IN_TESTS=false
SCORING_WEIGHTS_FAIL_FAST=false
RATE_LIMIT_IP_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=30
RATE_LIMIT_USER_PER_DAY=300
# 运行环境（development|test|staging|production）。生产必须设为 production：
# 该环境下 COOKIE_SECURE 强制为 true（显式设 false 会启动失败），HSTS 也仅在该环境生效。
APP_ENV=development
# Cookie Secure 标志。不设置时按环境推断：production 自动为 true，其余为 false。
# 生产建议显式开启并配合 HTTPS；纯 HTTP 部署必须保持 false，否则浏览器会拒绝保存 Cookie。
# COOKIE_SECURE=true
# Cookie SameSite 策略（lax|strict|none）。默认 lax：跨站写请求不再携带 Cookie，
# 是本项目对 CSRF 的主要处置；更严格可设 strict；none 仅用于第三方嵌入场景，
# 且必须与 COOKIE_SECURE=true 同时使用（否则浏览器拒绝该 Cookie）。
COOKIE_SAMESITE=lax
# 是否信任反向代理注入的 X-Forwarded-For。仅当后端直连对端 IP 命中 TRUSTED_PROXIES
# 时才解析该头，否则一律使用直连地址，客户端伪造 X-Forwarded-For 无效。直连部署保持 false。
TRUST_PROXY_HEADERS=false
# 可信代理地址列表（逗号分隔，IP 或 CIDR，例如 127.0.0.1,10.0.0.0/8）。格式非法会在启动时报错。
TRUSTED_PROXIES=
# 安全响应头开关：X-Content-Type-Options: nosniff、X-Frame-Options: DENY、
# Referrer-Policy、Content-Security-Policy（default-src 'none'）。测试可设为 false 关闭。
SECURITY_HEADERS=true
# 是否发送 Strict-Transport-Security 响应头（max-age=31536000; includeSubDomains）。仅在 APP_ENV=production 时生效。
HSTS_ENABLED=false

# Docker Compose deployment
COMPOSE_PROJECT_NAME=insurance_staging
FRONTEND_PORT=18080
POSTGRES_DB=insurance
POSTGRES_USER=insurance
POSTGRES_PASSWORD=change_me_before_deploy
DATABASE_URL=postgresql+psycopg2://insurance:change_me_before_deploy@postgres:5432/insurance
REDIS_URL=redis://redis:6379

# ---- 产品池维护（TASK-034：聚合站为主、官网补充验证） ----
# 定时维护间隔（分钟）：发现新产品 URL + 抓取全部启用的采集任务。默认 720（12 小时）。
CRAWL_INTERVAL_MINUTES=720
# 是否在空库注入 165 个演示产品（仅本地演示/E2E 使用；生产必须 false，产品池只含真实抓取数据）。
SEED_DEMO_PRODUCTS=false
# 高置信草稿自动发布：LLM 抽取、置信度达阈值且字段完整（含精确匹配门控）的草稿自动发布并写审计，
# 其余进入人工审核队列。设为 false 则全部人工审核。
AUTO_PUBLISH_ENABLED=true
AUTO_PUBLISH_CONFIDENCE=0.8
# 从聚合站列表页（慧择/开心保首页）发现产品详情页并注册采集任务。
DISCOVERY_ENABLED=true
DISCOVERY_MAX_NEW_PER_SOURCE=20
